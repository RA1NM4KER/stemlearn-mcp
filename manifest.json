{
  "manifest_version": "0.3",
  "name": "stemlearn-mcp",
  "display_name": "STEMLearn MCP",
  "version": "0.1.0",
  "description": "Read-only local MCP server for STEMLearn Moodle students.",
  "long_description": "Runs locally over stdio using the token created by npm run auth. Provides read-only access to enrolled courses, course materials, deadlines, grades, forums, and notifications.",
  "author": { "name": "STEMLearn" },
  "license": "MIT",
  "keywords": ["stemlearn", "moodle", "mcp", "education"],
  "server": {
    "type": "node",
    "entry_point": "dist/server.js",
    "mcp_config": { "command": "node", "args": ["${__dirname}/dist/server.js"], "env": {} }
  },
  "user_config": {},
  "tools": [
    { "name": "moodle_list_courses", "description": "List enrolled courses" },
    { "name": "moodle_get_course", "description": "Read course structure" },
    { "name": "moodle_list_resources", "description": "List course files with opaque IDs" },
    { "name": "moodle_download_file", "description": "Read an authorized course file" },
    { "name": "course_overview", "description": "Summarize one course" },
    { "name": "upcoming_and_overdue", "description": "List deadlines across courses" }
  ],
  "compatibility": { "platforms": ["darwin", "win32", "linux"], "runtimes": { "node": ">=18.0.0" } }
}
