{
  "name": "stemlearn-mcp",
  "version": "0.1.0",
  "description": "Student-focused, read-only MCP server for STEMLearn (Stellenbosch University's Moodle) — courses, deadlines, grades, and course files. Fork of 1alexandrer/moodle-mcp.",
  "type": "module",
  "bin": {
    "stemlearn-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "auth": "node scripts/auth.mjs",
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "deploy": "wrangler deploy",
    "dev": "npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.84.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "moodle",
    "mcp",
    "claude",
    "education",
    "lms",
    "stemlearn",
    "student"
  ],
  "private": true
}
